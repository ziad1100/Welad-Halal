generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection for `prisma migrate deploy`.
  // Production (Neon): pooled host in DATABASE_URL, direct host in DIRECT_URL —
  // migrations use advisory locks and fail on transaction-mode poolers.
  // Local/CI: same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  owner
  manager
  employee
}

// Levels: owner 100, manager 50, employee 10. Checks compare permissionLevel,
// never role names — new levels can be inserted without rewriting guards.

enum ProductType {
  INVENTORY_ITEM
  SERVICE_ITEM
  RAW_MATERIAL
  BUNDLED_ITEM
}

enum MovementType {
  SALE
  PURCHASE
  RETURN
  ADJUSTMENT
  OPENING_BALANCE
  STOCKTAKE
}

enum OrderType {
  PICKUP
  RECEIVE
  DELIVERY
}

enum OrderStatus {
  PENDING
  HELD
  CONFIRMED
  COMPLETED
  CANCELLED
  RETURNED
}

enum AlertKind {
  CASH_DISCREPANCY
  PENDING_RETURN_APPROVAL
  LOW_STOCK
  DAILY_SUMMARY
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ShiftStatus {
  open
  closed
}

model User {
  id                  String   @id @default(cuid())
  fullName            String   @map("full_name")
  username            String   @unique
  passwordHash        String   @map("password_hash")
  role                Role     @default(employee)
  permissionLevel     Int      @default(10) @map("permission_level")
  isOwner             Boolean  @default(false) @map("is_owner")
  createdByUserId     String?  @map("created_by_user_id")
  createdBy           User?    @relation("UserCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers        User[]   @relation("UserCreator")
  forcePasswordChange Boolean  @default(false) @map("force_password_change")
  isActive            Boolean  @default(true) @map("is_active")
  phone               String?
  email               String?
  lastLoginAt         DateTime? @map("last_login_at")
  permissions         String[]  @default([]) @map("permissions")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  ordersCreated  Order[]         @relation("CreatedBy")
  deliveries     Order[]         @relation("DeliveryRep")
  movements      StockMovement[]
  expenses       Expense[]
  employee       Employee?
  stockTakes     StockTake[]
  auditLogs      AuditLog[]
  purchases      PurchaseOrder[]
  shiftsClosed      Shift[]           @relation("ShiftClosedBy")
  ordersRefunded    Order[]           @relation("OrderRefundedBy")
  alerts            Alert[]
  pushSubscriptions PushSubscription[]

  @@index([role, isActive])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  nameAr    String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id            String      @id @default(cuid())
  name          String
  nameAr        String?
  description   String?
  barcode       String?     @unique
  sku           String?     @unique
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productType   ProductType @default(INVENTORY_ITEM)
  unit          String      @default("قطعة")
  unitOfMeasure String?
  supplierCode  String?
  purchasePrice Decimal     @default(0) @db.Decimal(12, 2)
  retailPrice   Decimal     @default(0) @db.Decimal(12, 2)
  taxRate       Decimal     @default(0) @db.Decimal(5, 2)
  // Multiple price tiers, e.g. [{tier:"قطاعي",price:140},{tier:"جملة",price:125}]
  priceTiers    Json?
  // Sub units of measure, e.g. [{unit:"كرتونة",factor:12,price:1500,taxRate:0}]
  subUnits      Json?
  // Preferred supplier link
  supplierId    String?
  supplier      Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  prices         ProductPrice[]
  inventory      Inventory?
  batches        InventoryBatch[]
  stockTakeLines StockTakeLine[]
  movements      StockMovement[]
  orderItems     OrderItem[]
  purchaseItems  PurchaseItem[]
  components     ProductComponent[] @relation("BundleComponents")
  usedIn         ProductComponent[] @relation("ComponentOf")

  @@index([categoryId])
  @@index([active])
  @@index([name])
}

model ProductComponent {
  id          String  @id @default(cuid())
  bundleId    String
  bundle      Product @relation("BundleComponents", fields: [bundleId], references: [id], onDelete: Cascade)
  componentId String
  component   Product @relation("ComponentOf", fields: [componentId], references: [id], onDelete: Restrict)
  quantity    Decimal @db.Decimal(12, 3)

  @@unique([bundleId, componentId])
  @@index([componentId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  purchases PurchaseOrder[]

  @@index([name])
}

model Employee {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  email     String?
  address   String?
  salary    Decimal   @default(0) @db.Decimal(12, 2)
  hireDate  DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shifts Shift[]
}

model ProductPrice {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  price         Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([productId, effectiveFrom])
}

model Inventory {
  id              String   @id @default(cuid())
  productId       String   @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Decimal  @default(0) @db.Decimal(12, 3)
  minimumQuantity Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt       DateTime @updatedAt
}

// Per-delivery lots: same product, different expiry dates can coexist.
// Informational layer — sales still deduct from Inventory.quantity.
model InventoryBatch {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNo    String?
  expiryDate DateTime?
  quantity   Decimal   @default(0) @db.Decimal(12, 3)
  createdAt  DateTime  @default(now())

  @@index([productId])
  @@index([expiryDate])
}

enum StockTakeStatus {
  OPEN
  COMMITTED
  CANCELLED
}

model StockTake {
  id          String          @id @default(cuid())
  name        String
  status      StockTakeStatus @default(OPEN)
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  committedAt DateTime?
  lines       StockTakeLine[]

  @@index([status, createdAt])
}

model StockTakeLine {
  id         String    @id @default(cuid())
  takeId     String
  take       StockTake @relation(fields: [takeId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  systemQty  Decimal   @db.Decimal(12, 3)
  countedQty Decimal?  @db.Decimal(12, 3)

  @@unique([takeId, productId])
  @@index([productId])
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          MovementType
  quantity      Decimal      @db.Decimal(12, 3)
  referenceType String?
  referenceId   String?
  notes         String?
  createdById   String?
  createdBy     User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([referenceId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  notes     String?
  // Credit/deferred account balance (positive = customer owes the store)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([name])
  @@index([phone])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   Int         @unique @default(autoincrement())
  orderType     OrderType   @default(PICKUP)
  status        OrderStatus @default(PENDING)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?       @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deliveryRepId String?
  deliveryRep   User?       @relation("DeliveryRep", fields: [deliveryRepId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  closedAt      DateTime?
  departureTime DateTime?
  // Cash actually leaving the drawer: set when a previously-confirmed order
  // is cancelled or returned. Drives expected-cash math in ShiftsService.
  refundedById  String?
  refundedBy    User?       @relation("OrderRefundedBy", fields: [refundedById], references: [id], onDelete: SetNull)
  refundedAt    DateTime?
  totalItems    Int         @default(0)
  totalQuantity Decimal     @default(0) @db.Decimal(12, 3)
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  discount      Decimal     @default(0) @db.Decimal(12, 2)
  tax           Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @default(0) @db.Decimal(12, 2)
  notes         String?

  // §1 — non-sequential public token (customer receipt QR → public order page).
  publicToken String?  @unique @map("public_token")
  // §1 — 1–5 star customer rating captured from the public order page.
  rating      Int?
  ratingNote  String?  @map("rating_note")
  // §2 — discount code snapshot applied at confirmation (server-validated).
  discountCode String? @map("discount_code")
  // §4 — drawer math: only CASH orders/refunds count toward expected drawer cash.
  paymentMethod String @default("CASH")
  // §7 — manager/owner return-approval flow: request stamped, stock untouched
  // until approve-return restores it. Plain columns: cashier identity recorded
  // in the audit log + alert payload, not via a relation.
  refundRequestedById String?  @map("return_requested_by_id")
  refundRequestedAt   DateTime? @map("return_requested_at")

  items OrderItem[]

  @@index([status, createdAt])
  @@index([orderType])
  @@index([customerId])
  @@index([refundedAt])
  @@index([refundRequestedAt])
}

// §2 — promotional discount codes / coupons (one promotions system: validated
// server-side at order confirmation; usage count guards the usage limit).
model DiscountCode {
  id            String   @id @default(cuid())
  code          String   @unique
  // "percentage" | "fixed_amount"
  discountType  String   @map("discount_type") @default("percentage")
  discountValue Decimal  @db.Decimal(12, 2)
  validFrom     DateTime?
  validUntil    DateTime?
  usageLimit    Int?
  timesUsed     Int      @default(0) @map("times_used")
  isActive      Boolean  @default(true) @map("is_active")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
}


model Shift {
  id                 String      @id @default(cuid())
  employeeId         String
  employee           Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branchId           String?
  openingCashAmount   Decimal     @db.Decimal(12, 2)
  closingCashAmount   Decimal?    @db.Decimal(12, 2)
  expectedCashAmount  Decimal?    @db.Decimal(12, 2)
  discrepancyAmount   Decimal?    @db.Decimal(12, 2)
  startedAt          DateTime    @default(now())
  endedAt            DateTime?
  status             ShiftStatus @default(open)
  closedById         String?
  closedBy           User?       @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([employeeId, startedAt])
  @@index([status, startedAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Alert {
  id        String        @id @default(cuid())
  kind      AlertKind
  severity  AlertSeverity @default(WARNING)
  title     String
  message   String
  payload   Json?
  isRead    Boolean       @default(false)
  readAt    DateTime?
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([kind, createdAt])
  @@index([isRead, createdAt])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productNameSnapshot String
  unitPriceSnapshot   Decimal @db.Decimal(12, 2)
  quantity            Decimal @db.Decimal(12, 3)
  discount            Decimal @default(0) @db.Decimal(12, 2)
  tax                 Decimal @default(0) @db.Decimal(12, 2)
  lineTotal           Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model PurchaseOrder {
  id           String         @id @default(cuid())
  supplierName String
  supplierId   String?
  supplier     Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status       String         @default("RECEIVED")
  subtotal     Decimal        @default(0) @db.Decimal(12, 2)
  total        Decimal        @default(0) @db.Decimal(12, 2)
  notes        String?
  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  items        PurchaseItem[]
}

model PurchaseItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Decimal       @db.Decimal(12, 3)
  purchasePrice   Decimal       @db.Decimal(12, 2)
  lineTotal       Decimal       @db.Decimal(12, 2)
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @default("general")
  notes       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  details   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([username, createdAt])
}

// §7 — PWA Web-Push subscriptions (manager/owner phones). Stored per user so
// an alert fan-out can reach the manager's phone when the app is closed.
model PushSubscription {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint     String   @unique
  p256dh       String   @map("p256dh")
  auth         String
  userAgent    String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  @@index([userId])
}

// Offline-first support (§5d): deduplicates retried order creations from the
// Electron outbox (or any client) via the `Idempotency-Key` request header.
// A key is claimed (statusCode 0 = in-flight) before the order transaction;
// on success it stores the created order id so replays return the SAME order
// instead of creating a duplicate. Failed attempts release the claim so the
// client can retry with the same key. Additive table — no existing data touched.
model IdempotencyKey {
  key        String   @id
  userId     String?
  orderId    String?
  statusCode Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

