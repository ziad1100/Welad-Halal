# ─── KStore POS — environment template (copy to .env, never commit secrets) ───

# PostgreSQL — local Docker
DATABASE_URL=postgresql://kstore:kstore@127.0.0.1:5432/kstore?schema=public
# Direct (unpooled) connection for `prisma migrate deploy`.
# Local: same as DATABASE_URL. Production (Neon): pooled host in DATABASE_URL,
# direct (non-pooler) host in DIRECT_URL — migrations fail on pooled hosts.
DIRECT_URL=postgresql://kstore:kstore@127.0.0.1:5432/kstore?schema=public

# Backend
PORT=3001
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379

# Frontend (Vercel prod → Render backend, e.g. https://kstore-api.onrender.com/api)
VITE_API_URL=http://localhost:3001/api

# Desktop (Electron packaged builds): WEB APP origin loaded by the checkout shell.
# Dev default is http://localhost:5173 (see apps/desktop/src/main.js WELAD_WEB_URL).
# Production installer builds must set WELAD_WEB_URL=https://<your-vercel-app>.vercel.app
# (the Vercel-hosted frontend — the shell loads the web UI, which itself calls
# the Render backend via its own baked VITE_API_URL).
WELAD_WEB_URL=http://localhost:5173
# Desktop offline-outbox sync target (apps/desktop/src/sync.js API_BASE).
# Production: https://<render-service>.onrender.com/api
WELAD_API_URL=http://localhost:3001/api

# ─── Smart Alerts / Daily Summary (Section 3) ───
# Cron for the scheduled report (6 fields: min hour dom mon dow). Default 23:59.
DAILY_SUMMARY_CRON=59 23 * * *
# WhatsApp Business Cloud API (optional) — leave empty to skip the channel.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Recipient phone (owner/manager), international format without '+', e.g. 201234567890
SUMMARY_WHATSAPP_TO=
# SMTP email (optional) — leave empty to skip the channel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Recipient email for the daily summary
SUMMARY_EMAIL_TO=

# ─── Manager PWA Web Push (Section 7, optional) ───
# Generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@weladhalal.example
